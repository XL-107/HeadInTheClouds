{
  "name": "InTheClouds",
  "description": "An extension that blocks access to prohibited sites.",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://reddit.com/*",
    "*://*.reddit.com/*",
    "*://youtube.com/*",
    "*://*.youtube.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "blocked_sites",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png"
  }
}
